# Writes ${OUT} (sea/Support/VersionInfo.inc) with the build-time version:
# run at every build (target sea-version), the file is rewritten only when
# its content changes, so an unchanged tree rebuilds nothing.
#   -DSRC=<source dir> -DOUT=<file> -DVERSION=<x.y.z> -DLLVM_REV_FILE=<file>
#   [-DDESCRIBE=<override>] [-DGIT=<git executable>]
if(NOT DESCRIBE)
  set(DESCRIBE "unknown")
  if(GIT)
    execute_process(
      COMMAND ${GIT} -C ${SRC} describe --tags --always --dirty --abbrev=12
      OUTPUT_VARIABLE d OUTPUT_STRIP_TRAILING_WHITESPACE
      RESULT_VARIABLE r ERROR_QUIET)
    if(r EQUAL 0 AND d)
      set(DESCRIBE "${d}")
    endif()
  endif()
endif()
set(LLVM_REV "unknown")
if(EXISTS ${LLVM_REV_FILE})
  file(STRINGS ${LLVM_REV_FILE} LLVM_REV LIMIT_COUNT 1)
endif()
set(content "// generated by cmake/SeaVersion.cmake: do not edit
#define SEA_MLIR_VERSION \"${VERSION}\"
#define SEA_MLIR_GIT_DESCRIBE \"${DESCRIBE}\"
#define SEA_MLIR_LLVM_REVISION \"${LLVM_REV}\"
")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE ${OUT} "${content}")
