// The canonical linear forms of the query (include/sea/Expr/CanonicalSums.hh,
// sea-vc --vc-canonical-sums): each item of the form on exact terms, and
// random linear terms at widths 1 to 64, each equivalent to its rewrite (a
// miter, unknowns within its limit shown) and equal at random ground points.
// unittests/CanonicalSums.
RUN: sea-canonical-sums-test 200 | FileCheck %s
CHECK: test: shape ok
CHECK: test: order ok
CHECK: test: eq ok
CHECK: test: extract ok
CHECK: test: bitwise ok
CHECK: test: image ok
CHECK: test: sub ok
CHECK: test: eq-modes ok
CHECK: test: inner ok
CHECK: random: neg=bvnot eq=balance inner=flatten terms=200 {{.*}} unknown={{[0-9]$}}
CHECK: test: random ok
CHECK: random: neg=sub eq=balance inner=flatten terms=100 {{.*}} unknown={{[0-9]$}}
CHECK: test: random-sub ok
CHECK: random: neg=bvnot eq=unshared inner=flatten terms=50 {{.*}} unknown={{[0-9]$}}
CHECK: test: random-unshared ok
CHECK: random: neg=bvnot eq=keep inner=flatten terms=50 {{.*}} unknown={{[0-9]$}}
CHECK: test: random-keep ok
CHECK: random: neg=bvnot eq=balance inner=shared-leaf terms=50 {{.*}} unknown={{[0-9]$}}
CHECK: test: random-shared-leaf ok
CHECK: failures: 0

RUN: not --crash sea-canonical-sums-test reuse 2>&1 | FileCheck %s --check-prefix=REUSE
REUSE: twice on one object {{.*}}[expr.canonical-sums-reused]
REUSE-NOT: no crash

