// utils/output-diff.py: OLD and NEW builds over a corpus and a matrix. The
// tests pin the per-job class, the key differences and the status only.
RUN: rm -rf %t && split-file %s %t
DEFINE: %{od} = %python %sea_src_root/utils/output-diff.py
DEFINE: %{in} = %sea_src_root/test/VC/brunch-stats.mlir %sea_src_root/test/VC/abs.mlir
// (matrix files: lit would substitute tool names in a RUN line)
DEFINE: %{m} = --matrix %t/matrix

// The masks and key lists without a build.
RUN: %{od} --self-test | FileCheck %s --check-prefix=SELF
SELF: self-test: pass

// The same build as OLD and NEW: every job identical (timings masked).
RUN: %{od} --old %sea_bin --new %sea_bin %{m} %{in} | FileCheck %s --check-prefix=SAME
SAME-DAG: brunch-stats seam text identical
SAME-DAG: brunch-stats seam jsonl identical
SAME-DAG: abs run jsonl identical
SAME: total: jobs=12 identical=12 diff=0 keys-diff=0 brunch-diff=0
SAME: status: pass

// A NEW sea-vc that appends one stat line: a DIFF naming the key, status 1;
// sea-run (unchanged) stays identical.
RUN: mkdir -p %t/new && ln -s %sea_bin/sea-run %t/new/sea-run
RUN: sed 's|@BIN@|%sea_bin|' %t/wrap.sh > %t/new/sea-vc && chmod +x %t/new/sea-vc
RUN: not %{od} --old %sea_bin --new %t/new %{m} %{in} | FileCheck %s --check-prefix=KEY
KEY-DAG: brunch-stats seam text DIFF stdout keys=+extra.key
KEY-DAG: brunch-stats plain jsonl DIFF stdout keys=+extra.key
KEY-DAG: abs run text identical
KEY: total: jobs=12 identical=4 diff=8 keys-diff=8 brunch-diff=0
KEY: status: fail

// A NEW sea-vc that only writes one extra stderr line: DIFF stderr, status fail.
RUN: mkdir -p %t/err && ln -s %sea_bin/sea-run %t/err/sea-run
RUN: sed 's|@BIN@|%sea_bin|' %t/wrap-err.sh > %t/err/sea-vc && chmod +x %t/err/sea-vc
RUN: not %{od} --old %sea_bin --new %t/err --matrix %t/vconly %sea_src_root/test/VC/abs.mlir | FileCheck %s --check-prefix=ERR
ERR: abs plain text DIFF stderr
ERR: status: fail

// A NEW sea-vc that only changes the exit status: DIFF rc=, status fail.
RUN: mkdir -p %t/rc && ln -s %sea_bin/sea-run %t/rc/sea-run
RUN: sed 's|@BIN@|%sea_bin|' %t/wrap-rc.sh > %t/rc/sea-vc && chmod +x %t/rc/sea-vc
RUN: not %{od} --old %sea_bin --new %t/rc --matrix %t/vconly %sea_src_root/test/VC/abs.mlir | FileCheck %s --check-prefix=RC
RC: abs plain text DIFF rc=
RC: status: fail

// A missing input is an error, not an empty corpus.
RUN: not %{od} --old %sea_bin --new %sea_bin %{m} %t/no-such.mlir 2>&1 | FileCheck %s --check-prefix=NOIN
NOIN: error: no input {{.*}}no-such.mlir

// Every program named in QUICK_SLOW exists, and --quick leaves out its
// heavy entries (quick-excluded) while the light ones run.
RUN: %python -c "import importlib.util as u,os,sys; s=u.spec_from_file_location('o',sys.argv[1]); m=u.module_from_spec(s); s.loader.exec_module(m); [print('slow-exists', n) for n in m.QUICK_SLOW if os.path.isfile(os.path.join(sys.argv[2], n.split('/',1)[0], n.split('/',1)[1] + '.mlir'))]" %sea_src_root/utils/output-diff.py %sea_src_root/test | FileCheck %s --check-prefix=SLOW
SLOW-COUNT-6: slow-exists
RUN: mkdir -p %t/VC && cp %sea_src_root/test/VC/intrinsics-unsat.mlir %t/VC/
RUN: %{od} --quick --old %sea_bin --new %sea_bin --matrix %t/quickslow %t/VC | FileCheck %s --check-prefix=QSLOW
QSLOW: quick-excluded: VC/intrinsics-unsat entries=other
QSLOW: skipped: other=2
QSLOW: status: pass

// An entry whose every job fails on both sides checked nothing: incomplete.
RUN: not %{od} --old %sea_bin --new %sea_bin --matrix %t/runonly %t/bad.mlir | FileCheck %s --check-prefix=ALLF
ALLF: bad run text identical rc=1
ALLF: entry: run tool=sea-run jobs=2 identical=2 diff=0 rc-nonzero=2
ALLF-NEXT: entry: run all-failed
ALLF: status: incomplete

// A flag one build does not accept is refused before any job (both sides
// would fail alike and compare identical).
RUN: not %{od} --old %sea_bin --new %sea_bin --matrix %t/bad %{in} 2>&1 | FileCheck %s --check-prefix=FLAG
FLAG: error: old: sea-vc does not accept --no-such-flag (entry x)

// --quick drops the heavy entries only for bench-corpus inputs: here
// (inputs outside $SEA_BENCH_SUITES) every entry runs, so none is skipped.
RUN: env SEA_BENCH_SUITES=%t/none %{od} --quick --old %sea_bin --new %sea_bin --matrix %t/heavy %sea_src_root/test/Interp/ptr/segment.mlir | FileCheck %s --check-prefix=QUICK
QUICK: segment h text identical
QUICK: skipped: -
RUN: mkdir -p %t/suites/vcc && cp %sea_src_root/test/Interp/ptr/segment.mlir %t/suites/vcc/b.mlir
RUN: env SEA_BENCH_SUITES=%t/suites %{od} --quick --old %sea_bin --new %sea_bin --matrix %t/heavy %t/suites/vcc | FileCheck %s --check-prefix=QUICKB
QUICKB: entry: h tool=sea-run jobs=0
QUICKB: skipped: h=2

RUN: %{od} --agent | FileCheck %s --check-prefix=AGENT
AGENT: STATUS:

//--- matrix
seam sea-vc: --lower --seam --seam-stats --brunch-stats
plain sea-vc: --brunch-stats
run sea-run: --missing=zero
//--- heavy
h sea-run heavy: --missing=zero
//--- quickslow
other sea-vc: --lower
seam-stats sea-vc: --lower --seam --seam-stats
//--- vconly
plain sea-vc: --brunch-stats
//--- runonly
run sea-run: --missing=zero
//--- bad.mlir
not a program
//--- bad
x sea-vc: --no-such-flag
//--- wrap.sh
#!/bin/sh
"@BIN@/sea-vc" "$@"
rc=$?
case " $* " in
*--format=jsonl*) echo '{"kind":"stat","key":"extra.key","value":1,"text":"extra.key: 1"}' ;;
*) echo 'extra.key: 1' ;;
esac
exit $rc

//--- wrap-err.sh
#!/bin/sh
"@BIN@/sea-vc" "$@"
rc=$?
echo 'one extra line' >&2
exit $rc
//--- wrap-rc.sh
#!/bin/sh
"@BIN@/sea-vc" "$@"
exit 7

