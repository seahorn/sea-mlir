// Output files are written whole (sea/Support/WriteFile.h): a write that
// fails (here: into a directory that does not exist) is an error of the
// file's kind, and the tool stops; a written file is complete and leaves
// no temporary behind.
// RUN: rm -rf %t && split-file %s %t
// DEFINE: %{out} = %t/missing/w.place
// DEFINE: %{place} = sea-opt --pass-pipeline='builtin.module(sea.program(sea-place-static{place-out=%{out}}))' %t/one.mlir -o /dev/null
// DEFINE: %{in} = %S/../VC/ack-dump-pairs-loc.mlir --lower --lower-opt=false --seam --ackermannize=on --vcgen-only --program=reads

// RUN: not sea-vc %{in} --print-lowered=%t/missing/low.mlir 2>&1 | FileCheck %s --check-prefix=LOWERED
// LOWERED: Error: --print-lowered: cannot write '{{.*}}missing{{/|\\}}low.mlir': {{.*}} [vc.print-lowered]
// RUN: not sea-vc %{in} --ack-dump-pairs=%t/missing/pairs.txt 2>&1 | FileCheck %s --check-prefix=PAIRS
// PAIRS: Error: --ack-dump-pairs: cannot write '{{.*}}missing{{/|\\}}pairs.txt': {{.*}} [vc.ack-dump-pairs]
// RUN: not %{place} 2>&1 | FileCheck %s --check-prefix=PLACE
// PLACE: Error: sea-place-static: the placement file: cannot write '{{.*}}missing{{/|\\}}w.place': {{.*}} [place.out-file]

// RUN: sea-vc %{in} --print-lowered=%t/low.mlir --ack-dump-pairs=%t/pairs.txt
// RUN: FileCheck %s --check-prefix=OK-LOWERED < %t/low.mlir
// RUN: FileCheck %s --check-prefix=OK-PAIRS < %t/pairs.txt
// REDEFINE: %{out} = %t/w.place
// RUN: %{place}
// RUN: FileCheck %s --check-prefix=OK-PLACE < %t/w.place
// RUN: ls -a %t | FileCheck %s --check-prefix=NOTMP
// OK-LOWERED: // sea-vc --print-lowered:
// OK-LOWERED: sea.program @reads
// OK-PAIRS: array 0
// OK-PLACE: # sea-place-static placement of @one
// OK-PLACE-NEXT: name=stack.1 kind=stack
// NOTMP-NOT: .tmp

//--- one.mlir
sea.program @one {
  %n8 = sea.const 8 : i64
  %a = sea.alloca %n8 align 8 [1] : i64 -> !sea.ptr<64>
  sea.halt
}

