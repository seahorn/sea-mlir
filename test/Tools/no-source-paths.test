# The tools compile in no source or build path: they find their data
# (docs, profiles) at run time (sea/Support/InstallLayout.h), so a release
# binary does not carry the machine it was built on. Optimized builds
# only: Debug / RelWithDebInfo keep __FILE__ and debug info. RUNPATH
# entries of the solver libraries are not source paths (docs/Release.md).
REQUIRES: release-build
RUN: %python %S/Inputs/no-paths-check.py --path %sea_src_root/ --path %sea_obj_root/ %sea_bin/sea-vc %sea_bin/sea-run %sea_bin/sea-opt %sea_bin/sea-reduce %sea_bin/sea-seam-export | FileCheck %s
CHECK-NOT: no-paths.found
CHECK: no-paths.checked: 5 binaries

# The check finds a path.
RUN: echo "x%sea_src_root/profiles" > %t.bin
RUN: not %python %S/Inputs/no-paths-check.py --path %sea_src_root/ %t.bin | FileCheck %s --check-prefix=FOUND
FOUND: no-paths.found: {{.*}}.bin: {{.*}} x1

