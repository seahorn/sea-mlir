ORACLE: op semantics vs z3 (see test/README.md).
REQUIRES: z3
RUN: %if yices %{ %python %sea_src_root/utils/check-semantics.py --sea-run sea-run --sea-expr-eval sea-expr-eval --sea-opt sea-opt --z3 %z3 --fold --seed 1 --random 8 | FileCheck %s --check-prefix=YICES %}
RUN: %if !yices %{ %python %sea_src_root/utils/check-semantics.py --sea-run sea-run --sea-expr-eval sea-expr-eval --sea-opt sea-opt --z3 %z3 --no-yices --fold --seed 1 --random 8 | FileCheck %s --check-prefix=NOYICES %}
YICES: checked {{[0-9]+}} cases, {{[0-9]+}} results from 5 implementations (sea-run, expanded, folded, expr-z3, expr-yices), 0 mismatches
NOYICES: checked {{[0-9]+}} cases, {{[0-9]+}} results from 4 implementations (sea-run, expanded, folded, expr-z3), 0 mismatches

