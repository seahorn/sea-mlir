ORACLE: VC vs interpreter on random programs, with Bitwuzla too (see test/README.md).
REQUIRES: bitwuzla
RUN: %python %sea_src_root/utils/fuzz-vc.py --sea-vc sea-vc --sea-run sea-run --sea-opt sea-opt %if !yices %{ --no-yices %} --seed 3 -n 30 --runs 5 --bitwuzla | FileCheck %s
CHECK: programs: 30 sat: {{[1-9][0-9]*}} unsat: {{[1-9][0-9]*}} failures: 0

