// Prints change nothing in the VC (docs/design/Print.md): OpSem encodes
// no term for them, and every pass of the lowering accepts them. The query
// (--smt2) of a program is byte-identical with no prints, with weak prints
// after every value and with strong prints of every used value
// (sea-test-insert-prints), through the lowering with and without SeaM and
// memory widening. (Strong prints of unused values keep them alive; the VC
// encodes every op, so that costs nothing either: array_list_swap.)

// RUN: sea-opt %S/../seam/Inputs/array_list_swap.mlir --mlir-print-debuginfo > %t.als.n.mlir
// RUN: sea-opt %S/../seam/Inputs/array_list_swap.mlir --mlir-print-debuginfo --pass-pipeline='builtin.module(sea.program(sea-test-insert-prints{mode=weak}))' > %t.als.w.mlir
// RUN: sea-opt %S/../seam/Inputs/array_list_swap.mlir --mlir-print-debuginfo --pass-pipeline='builtin.module(sea.program(sea-test-insert-prints{mode=strong}))' > %t.als.s.mlir
// RUN: FileCheck %s --check-prefix=PRINTS < %t.als.w.mlir
// RUN: FileCheck %s --check-prefix=PRINTS < %t.als.s.mlir
// RUN: sea-vc %t.als.n.mlir --lower --smt2 > %t.als.lower.n.smt2 2>/dev/null
// RUN: sea-vc %t.als.w.mlir --lower --smt2 > %t.als.lower.w.smt2 2>/dev/null
// RUN: sea-vc %t.als.s.mlir --lower --smt2 > %t.als.lower.s.smt2 2>/dev/null
// RUN: FileCheck %s --check-prefix=QUERY < %t.als.lower.n.smt2
// RUN: diff %t.als.lower.n.smt2 %t.als.lower.w.smt2
// RUN: diff %t.als.lower.n.smt2 %t.als.lower.s.smt2
// RUN: sea-vc %t.als.n.mlir --lower --seam --smt2 > %t.als.seam.n.smt2 2>/dev/null
// RUN: sea-vc %t.als.w.mlir --lower --seam --smt2 > %t.als.seam.w.smt2 2>/dev/null
// RUN: sea-vc %t.als.s.mlir --lower --seam --smt2 > %t.als.seam.s.smt2 2>/dev/null
// RUN: FileCheck %s --check-prefix=QUERY < %t.als.seam.n.smt2
// RUN: diff %t.als.seam.n.smt2 %t.als.seam.w.smt2
// RUN: diff %t.als.seam.n.smt2 %t.als.seam.s.smt2
// RUN: sea-vc %t.als.n.mlir --lower --widen-memory=8 --smt2 > %t.als.widen.n.smt2 2>/dev/null
// RUN: sea-vc %t.als.w.mlir --lower --widen-memory=8 --smt2 > %t.als.widen.w.smt2 2>/dev/null
// RUN: sea-vc %t.als.s.mlir --lower --widen-memory=8 --smt2 > %t.als.widen.s.smt2 2>/dev/null
// RUN: FileCheck %s --check-prefix=QUERY < %t.als.widen.n.smt2
// RUN: diff %t.als.widen.n.smt2 %t.als.widen.w.smt2
// RUN: diff %t.als.widen.n.smt2 %t.als.widen.s.smt2
