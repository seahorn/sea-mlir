ORACLE: VC vs interpreter on random programs (see test/README.md).
RUN: %python %sea_src_root/utils/fuzz-vc.py --sea-vc sea-vc --sea-run sea-run --sea-opt sea-opt %if !yices %{ --no-yices %} --seed 1 -n 60 --runs 10 | FileCheck %s
CHECK: programs: 60 sat: {{[1-9][0-9]*}} unsat: {{[1-9][0-9]*}} failures: 0

