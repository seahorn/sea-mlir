// sea-drop-fresh-memhavoc rests on A-SEP: a store to another object, out
// of its bounds, may land in the fresh object after placement, and then
// the memhavoc was not a no-op. The drop is reported as A-SEP reliance,
// also without --seam and with --seam-premises=0 (discharged by a separate
// memory-safety check, not in sea-mlir yet).
// RUN: split-file %s %t
// RUN: sea-vc %t/oob.mlir --lower | FileCheck %s --check-prefix=OOB
// OOB: assume.a-sep: drop-fresh-memhavoc=1
// OOB: result: unsat
// RUN: sea-vc %t/oob.mlir --lower --seam --seam-premises=0 | FileCheck %s --check-prefix=INB0
// INB0: seam.premises: off (lowering: drop-fresh-memhavoc=1 rests on A-SEP)
// With --seam the out-of-object store (it lands in another object) is
// reported and the premises stay; the model needs that store, so its
// replay leaves an object: inconclusive, exit 4.
// RUN: not sea-vc %t/oob.mlir --lower --seam 2>&1 | FileCheck %s --check-prefix=SEAM
// SEAM: [vc.seam-out-of-object]
// SEAM: seam.out-of-object: accesses=1 object=1
// SEAM: [vc.seam-inb-spurious]
// The opt-in fallback without the premises warns: the answer still rests
// on A-SEP.
// RUN: sea-vc %t/oob.mlir --lower --seam --seam-out-of-object=fallback 2>&1 | FileCheck %s --check-prefix=FALLBACK
// FALLBACK: [vc.seam-fallback-conditional]
// FALLBACK: seam.premises: off (fallback: {{.*}}) (lowering: drop-fresh-memhavoc=1 rests on A-SEP)
// RUN: sea-vc %t/oob.mlir --lower --brunch-stats | FileCheck %s --check-prefix=BRUNCH
// BRUNCH: BRUNCH_STAT assume.a-sep-drop-fresh-memhavoc 1
// The abstract program shows the out-of-bounds store.
// RUN: not sea-run %t/oob.mlir --input=2@heap.1+0=0 2>&1 | FileCheck %s --check-prefix=INTERP
// INTERP: status: error
// A read through another object before the memhavoc: after placement it
// may read the fresh object's cells (here b - 4 is the last cell of a), and
// then the memhavoc was not a no-op either. Any access before the memhavoc
// makes the drop rest on A-SEP. The placed program, where nothing is
// dropped, fails.
// RUN: sea-vc %t/xread.mlir --lower | FileCheck %s --check-prefix=XREAD
// XREAD: assume.a-sep: drop-fresh-memhavoc=1
// XREAD: result: unsat
// RUN: sea-vc %t/xread.mlir --lower --seam --seam-premises=0 | FileCheck %s --check-prefix=XREAD0
// XREAD0: seam.premises: off (lowering: drop-fresh-memhavoc=1 rests on A-SEP)
// RUN: sea-opt %t/xread.mlir --sea-lower-tracking --sea-lower-fat-pointers --sea-place-static -o %t/xread-placed.mlir
// RUN: sea-vc %t/xread-placed.mlir --lower | FileCheck %s --check-prefix=PLACED
// PLACED: result: sat
// PLACED: replay: assert-failed
// No access before the memhavoc and its range in the object: no reliance.
// RUN: sea-vc %t/plain.mlir --lower | FileCheck %s --check-prefix=PLAIN
// PLAIN-NOT: assume.a-sep
// PLAIN: result: sat
// REQUIRES: z3

//--- oob.mlir
!m = !sea.mem<!sea.ptr<64>, i8>
sea.program @main {
  %m0 = sea.mem.nondet "m" [0] : !m
  %c4 = sea.const 4 : i64
  %v = sea.const 9 : i8
  %a = sea.malloc %c4 align 4 [1] : i64 -> !sea.ptr<64>
  %b = sea.malloc %c4 align 4 [4] : i64 -> !sea.ptr<64>
  %m4 = sea.const -4 : i64
  %e = sea.ptr.add %b, %m4 : !sea.ptr<64>, i64
  %mu = sea.store %m0[%e], %v inplace : !m, i8
  %m2 = sea.memhavoc %mu[%a], %c4 [2] inplace : !m
  %x = sea.load %m2[%a] : !m -> i8
  %ok = sea.icmp eq, %x, %v : i8
  sea.assert %ok
  sea.halt
}

//--- xread.mlir
!m = !sea.mem<!sea.ptr<64>, i8>
sea.program @main {
  %m0 = sea.mem.nondet "m" [0] : !m
  %c4 = sea.const 4 : i64
  %a = sea.malloc %c4 align 4 [1] : i64 -> !sea.ptr<64>
  %b = sea.malloc %c4 align 4 [4] : i64 -> !sea.ptr<64>
  %i = sea.nondet "i" [3] : i64
  %m4 = sea.const -4 : i64
  %is = sea.icmp eq, %i, %m4 : i64
  sea.assume %is
  %e = sea.ptr.add %b, %i : !sea.ptr<64>, i64
  %x = sea.load %m0[%e] : !m -> i8
  %m1 = sea.memhavoc %m0[%a], %c4 [2] inplace : !m
  %y = sea.load %m1[%a] : !m -> i8
  %ok = sea.icmp eq, %x, %y : i8
  sea.assert %ok
  sea.halt
}

//--- plain.mlir
!m = !sea.mem<!sea.ptr<64>, i8>
sea.program @main {
  %m0 = sea.mem.nondet "m" [0] : !m
  %c4 = sea.const 4 : i64
  %p = sea.malloc %c4 align 4 [1] : i64 -> !sea.ptr<64>
  %m1 = sea.memhavoc %m0[%p], %c4 [2] inplace : !m
  %x = sea.load %m1[%p] : !m -> i8
  %k = sea.const 9 : i8
  %ok = sea.icmp ne, %x, %k : i8
  sea.assert %ok
  sea.halt
}

