# RUN: sea-vc %S/post-store.mlir --program=trail --lower --seam --vc-fold-top-eqs --vcgen-only --model-trail-out=%t.trail > %t.stats
# RUN: sea-vc %S/post-store.mlir --program=trail --lower --seam --vc-fold-top-eqs --smt2 2>/dev/null > %t.smt2
# RUN: %python %S/Inputs/check-trail.py %t.trail %t.stats | FileCheck %s
# RUN: %if z3 %{ %python %S/Inputs/check-trail.py %t.trail %t.stats --smt2 %t.smt2 --z3 %z3 | FileCheck %s %}
# RUN: FileCheck %s --check-prefix=FILE < %t.trail
# RUN: not sea-vc %S/post-store.mlir --program=trail --lower --seam --model-trail-out=%t.x 2>&1 | FileCheck %s --check-prefix=NEEDS
# --model-trail-out (docs/design/FoldTopEqs.md, "Model trail"): the file
# reads back, one JSON object per elimination, its counts equal the
# vc.model-trail counters, and its terms are SMT-LIB over the symbols of the
# --smt2 query.
# CHECK: trail: entries={{[1-9][0-9]*}} cells=1 defs={{[0-9]+}} ok
# FILE: "kind":"cell"
# NEEDS: --model-trail-out needs --vc-fold-top-eqs

