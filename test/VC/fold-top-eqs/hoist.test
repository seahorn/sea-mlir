// The concat-ite hoist of --vc-fold-top-eqs (hoistConcatItes,
// include/sea/VC/FoldTopEqs.h; docs/design/FoldTopEqs.md): a DAG of shared
// ite arms is hoisted once per distinct concat, not once per path, and does
// not grow; the numeral mode refuses a non-numeral leaf and a hoist that
// makes more ites than the parts hold (counted); every hoist z3-exact.
// ptr-facts: a fact whose term or concat part mentions an object (a
// PTR_SEGMENT) outside a memory read is not substituted; one that mentions
// none is, pointer observations of registers included ("Pointer
// observations"; docs/design/PtrSegment.md, "What F2 does then").
// concat-kept: a concat fact skipped for an object keeps the parts it
// defines in its own conjunct; the fold is z3-equivalent to its input.
// trail: a fact whose defining conjunct a rewrite turned into another form
// holding its term (injected) is re-added after the last round; the fold
// stays z3-equivalent (Q_0 <=> trail /\ Q_n); a constant's goes to step 2's
// model trail; a fact whose term left the query is not re-added.
RUN: sea-fold-top-eqs-test | FileCheck %s
CHECK: shared: mode=numeral concat-ite=47 refused=0
CHECK: test: shared ok
CHECK: leaves: numeral concat-ite=0 refused=1
CHECK: test: leaves ok
CHECK: budget: numeral concat-ite=0 refused=1
CHECK: test: budget ok
CHECK: refused-memo: order 0 concat-ite=1 refused=1
CHECK: refused-memo: order 1 concat-ite=1 refused=1
CHECK: test: refused-memo ok
CHECK: ptr-facts: addr folded=1 skipped-base=0
CHECK: ptr-facts: extract folded=1 skipped-base=0
CHECK: ptr-facts: sum folded=1 skipped-base=0
CHECK: ptr-facts: diff folded=1 skipped-base=0
CHECK: ptr-facts: read folded=1 skipped-base=0
CHECK: ptr-facts: value folded=1 skipped-base=0
CHECK: ptr-facts: seg-addr folded=0 skipped-base=1
CHECK: ptr-facts: seg-extract folded=0 skipped-base=1
CHECK: ptr-facts: seg-sum folded=0 skipped-base=1
CHECK: ptr-facts: seg-diff folded=0 skipped-base=1
CHECK: ptr-facts: seg-node folded=0 skipped-base=1
CHECK: ptr-facts: seg-read folded=1 skipped-base=0
CHECK: ptr-facts: concat-part x-folded=1 addr-folded=0 skipped-base={{[1-9][0-9]*}}
CHECK: test: ptr-facts ok
CHECK: concat-kept: top equiv=1 part-uses=1
CHECK: concat-kept: nested equiv=1 x-uses=1 y-uses=1
CHECK: test: concat-kept ok
CHECK: trail: term re-added=1 rounds={{[0-9]+}} in=unsat out=unsat equiv=1
CHECK: trail: const re-added=1 equiv=1 step2-trail=1 step2-mentions=0
CHECK: trail: two re-added=2 const=1 equiv=1 step2=unsat term-only=sat step2-mentions=0
CHECK: trail: bool re-added=1 const=1 cap=0 equiv=1
CHECK: trail: not-bool re-added=1 const=1 cap=0 equiv=1
CHECK: trail: concat-part re-added=1 const=1 cap=0 equiv=1
CHECK: trail: cap re-added=1 const=0 cap=1 equiv=1
CHECK: trail: path-mismatch re-added=0 const=0 cap=0 equiv=1
CHECK: trail: normal re-added=0 rounds={{[0-9]+}} equiv=1
CHECK: test: trail ok
CHECK: failures: 0

